# GEMINI_API_KEY: Required for Gemini AI API calls if using Gemini.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# External LLM Configuration (Required for translation and linguistic intelligence)
# Supports OpenAI-compatible (/v1/chat/completions), Anthropic (/v1/messages), or Gemini REST endpoints.
LLM_API_URL="https://api.openai.com/v1/chat/completions"
LLM_API_KEY=""
LLM_MODEL=""
# Optional: "openai" | "anthropic" | "gemini" (auto-detected from LLM_API_URL if omitted)
LLM_REQUEST_FORMAT=""

# AI Voice Dubbing Provider Configuration ("elevenlabs" | "external" | "gemini")
VOICE_PROVIDER="elevenlabs"
ELEVENLABS_API_KEY=""

# External Voice Cloning & Synthesis API (Optional override when VOICE_PROVIDER="elevenlabs",
# or primary voice cloner when VOICE_PROVIDER="external")
# Supported formats: "multipart" (default), "json_base64", "cartesia", "fish_audio"
# Fish Audio example: VOICE_CLONE_API_URL="https://api.fish.audio/v1/tts", VOICE_CLONE_FORMAT="fish_audio", VOICE_CLONE_MODEL="s2.1-pro-free"
VOICE_CLONE_API_URL=""
VOICE_CLONE_API_KEY=""
VOICE_CLONE_MODEL=""
VOICE_CLONE_FORMAT="multipart"
VOICE_CLONE_AUTH_HEADER="Authorization"
VOICE_CLONE_AUTH_PREFIX="Bearer"

# Optional External Speech-to-Text API (OpenAI Whisper-compatible /v1/audio/transcriptions)
# Used for transcription & SRT alignment when VOICE_PROVIDER="external" without ElevenLabs STT
STT_API_URL=""
STT_API_KEY=""
STT_MODEL="whisper-1"

# Optional Storage & Upload Limits
MAX_UPLOAD_MB="50"
MAX_DURATION_SEC="600"
TEMP_TTL_MS="3600000"
